 set -euo pipefail
 
 AGENT_INNER_CMD=()
+
+# Native transport replaces model dispatch after original role preparation.
+# Every actual task-source/workspace copy is sealed; credentials stay on host.
+nstack_native_role() {
+  local origin role
+  for origin in "${BASH_SOURCE[@]}"; do
+    role="${origin##*/}"
+    case "$role" in
+      task.sh|idea.sh|run.sh|variant_agent.sh|posthoc_agent.sh|paper.sh|paper_edit.sh)
+        printf '%s\n' "$role"; return 0 ;;
+    esac
+  done
+  echo "native bridge cannot identify original scientific role" >&2
+  return 2
+}
+
+append_native_sealed_masks() {
+  [ "${NSTACK_NATIVE_BRIDGE:-0}" = "1" ] || return 0
+  local source="$1" destination="$2" role masks_file flag mount existing found
+  role="$(nstack_native_role)" || return $?
+  masks_file="$(mktemp "${TMPDIR:-/tmp}/native-masks-XXXXXX")" || return $?
+  if ! "$PYTHON_BIN" "${NSTACK_NATIVE_BRIDGE_HELPER:?}" --mode masks --role "$role" \
+      --source "$source" --destination "$destination" > "$masks_file"; then
+    rm -f "$masks_file"; return 2
+  fi
+  while IFS= read -r -d '' flag && IFS= read -r -d '' mount; do
+    [ "$flag" = "-v" ] || { rm -f "$masks_file"; return 2; }
+    found=0
+    # Preserve original contract masks, adding each identical mask only once.
+    for existing in "${docker_cmd[@]}"; do
+      if [ "$existing" = "$mount" ]; then found=1; break; fi
+    done
+    [ "$found" = "1" ] || docker_cmd+=("$flag" "$mount")
+  done < "$masks_file"
+  rm -f "$masks_file"
+}
+
+append_native_agent_controls() {
+  [ "${NSTACK_NATIVE_BRIDGE:-0}" = "1" ] || return 0
+  docker_cmd+=(
+    --read-only --cap-drop ALL --security-opt no-new-privileges
+    --security-opt "seccomp=${NSTACK_NATIVE_AGENT_SECCOMP:?}"
+    --label nstack.research.agent=true --pids-limit 128
+    --cpus "${NSTACK_NATIVE_AGENT_CPUS:?}" --memory "${NSTACK_NATIVE_AGENT_MEMORY:?}"
+    --memory-swap "${NSTACK_NATIVE_AGENT_MEMORY:?}"
+    --tmpfs /tmp:rw,nosuid,nodev,size=268435456,mode=1777
+    --tmpfs /home/agent-home:rw,nosuid,nodev,size=67108864,mode=0700,uid=$(id -u),gid=$(id -g)
+  )
+  append_native_sealed_masks "$1" "$2"
+}
